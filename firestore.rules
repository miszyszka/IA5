rules_version = '2';
// CLAUDE.md sekcja 4 i zasada S1. <OWNER_UID> uzupełnić po pierwszym logowaniu.
service cloud.firestore {
  match /databases/{db}/documents {
    function isOwner() { return request.auth != null && request.auth.uid == "<OWNER_UID>"; }
    match /meta/{d}     { allow read: if true;      allow write: if false; }
    match /runner/{d}   { allow read: if true;      allow write: if false; }
    match /candles/{d}  { allow read: if isOwner(); allow write: if false; }
    match /candles_d1/{d} { allow read: if isOwner(); allow write: if false; }   // D-053: świece dzienne Yahoo
    match /candles_stk/{d} { allow read: if isOwner(); allow write: if false; }  // D-071: świece dzienne spółek
    // D-071: Stocks — strona zapisuje spółki, udziały, kapitał i pasmo ze statusem do_policzenia; resztę pól (stan liczenia) pisze Mac.
    match /stocks/{d} {
      function cfgOk() {
        let r = request.resource.data;
        return r.status == "do_policzenia" && r.updatedBy == request.auth.uid
          && r.tickers is list && r.tickers.size() >= 2 && r.tickers.size() <= 100
          && r.capital is number && r.capital >= 100 && r.capital <= 1000000000
          && r.band is number && r.band >= 0 && r.band <= 50 && r.requestedAt is number;
      }
      allow read: if isOwner();
      allow create: if isOwner() && d == "config" && cfgOk()
        && request.resource.data.keys().hasOnly(["tickers", "capital", "band", "status", "requestedAt", "updatedBy"]);
      allow update: if isOwner() && d == "config" && cfgOk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tickers", "capital", "band", "status", "requestedAt", "updatedBy"]);
    }
    // D-074: REV — moje konto: salda walut i moje przewalutowania (pisze tylko strona, Mac nie czyta).
    match /wallet/{d} {
      allow read: if isOwner() && d == "rev";
      allow write: if isOwner() && d == "rev"
        && request.resource.data.keys().hasOnly(["balances", "tx", "updatedAt"])
        && request.resource.data.balances is map && request.resource.data.balances.size() <= 40
        && request.resource.data.tx is list && request.resource.data.tx.size() <= 3000
        && request.resource.data.updatedAt is number;
    }
    match /strategies/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ["do_policzenia", "do_usuniecia"];
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["name", "hypothesis", "code", "status", "frozenAt", "frozenVariant"])
        && request.resource.data.status in ["do_policzenia", "do_usuniecia", "policzona", "blad"];
    }
    // D-045: wirtualni inwestorzy (paper trading). Ustawień nie da się zmienić — tylko usunąć (status do_usuniecia).
    match /investors/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "aktywny"
        && request.resource.data.keys().hasOnly(["name", "capital", "pct", "strategies", "status", "createdAt", "createdBy"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.capital is number && request.resource.data.capital >= 100 && request.resource.data.capital <= 100000000
        && request.resource.data.pct is number && request.resource.data.pct > 0 && request.resource.data.pct <= 100
        && request.resource.data.strategies is list && request.resource.data.strategies.size() >= 1
        && request.resource.data.strategies.size() <= 10
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
             && request.resource.data.status == "do_usuniecia")
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailAlerts"])
                && request.resource.data.emailAlerts is bool));   // D-051: jedyne ustawienie, które można zmienić
    }
  }
}
